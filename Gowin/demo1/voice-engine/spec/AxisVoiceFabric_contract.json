{
  "modules": [
    {
      "name": "AxisVoiceFabric",
      "rtl_path": "rtl/AxisVoiceFabric.v",
      "description": "Voice Engine内部任务路由与公平结果归并；外部主干是AXI内存映射。",
      "interfaces": {
        "ports": [
          {
            "name": "i_axis_aclk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "共用计算时钟"
          },
          {
            "name": "i_axis_arstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "异步清除资格，外部同步释放"
          },
          {
            "name": "i_s_axis_tdata",
            "direction": "input",
            "width": 320,
            "role": "data",
            "description": "本次任务的状态与参数"
          },
          {
            "name": "i_s_axis_tuser",
            "direction": "input",
            "width": 32,
            "role": "data",
            "description": "透明事务编号"
          },
          {
            "name": "i_s_axis_tdest",
            "direction": "input",
            "width": 8,
            "role": "data",
            "description": "操作码路由"
          },
          {
            "name": "i_s_axis_tlast",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "完整任务必须为单拍包"
          },
          {
            "name": "i_s_axis_tvalid",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "源端有效资格"
          },
          {
            "name": "o_s_axis_tready",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "入口可接纳"
          },
          {
            "name": "o_m_axis_tdata",
            "direction": "output",
            "width": 128,
            "role": "data",
            "description": "完成结果"
          },
          {
            "name": "o_m_axis_tuser",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "原请求编号"
          },
          {
            "name": "o_m_axis_tdest",
            "direction": "output",
            "width": 8,
            "role": "data",
            "description": "返回原操作码"
          },
          {
            "name": "o_m_axis_tlast",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "每个完成为单拍包"
          },
          {
            "name": "o_m_axis_tvalid",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "完成资格"
          },
          {
            "name": "i_m_axis_tready",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "下游接受完成"
          }
        ]
      },
      "clock": {
        "name": "i_axis_aclk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_axis_arstn",
        "active": "low",
        "style": "asynchronous"
      },
      "behavior": [
        "One ingress slot, five independent compute endpoints and one error completion lane.",
        "TDEST=0 PM,1 segment,2 MAC,3 noise,4 multi-envelope.",
        "Return low64 result, bits71:64 status; tag and destination preserved.",
        "Unknown opcode returns status1. TLAST=0 returns one status2 error and drains until packet end.",
        "Round-robin result arbitration, registered output holds all fields under backpressure.",
        "Completion order may differ from issue order; caller must track tag."
      ],
      "constraints": [
        "Candidate subsystem; existing board top unchanged; no Gowin timing/area claim.",
        "Common core clock only, no CDC. Caller provides synchronous reset release.",
        "AXI endpoint is a slave; it does not fetch RAM itself or implement a program scheduler."
      ],
      "corner_cases": [
        "backpressure and bubbles",
        "full and empty queues",
        "reset with in-flight tasks",
        "invalid stage or operation or bus request"
      ],
      "verification_cases": [
        "independent integer reference",
        "mixed tagged transactions and all sideband stability",
        "event/phase transition sequence",
        "AXI IDs, independent channels, WSTRB, bursts and FIFO side effects"
      ],
      "timing_diagrams": [
        {
          "id": "flow",
          "title": "任务提交与结果保持",
          "scenario": "flow",
          "description": "输入握手移交所有权；结果等待消费时数据和事务身份保持。精确延迟以行为合同为准。",
          "wavejson": {
            "signal": [
              {
                "name": "clock",
                "wave": "p........."
              },
              {
                "name": "request",
                "wave": "01.0......"
              },
              {
                "name": "processing",
                "wave": "01....0..."
              },
              {
                "name": "result_valid",
                "wave": "0.....1..0"
              },
              {
                "name": "result_ready",
                "wave": "1.....0.1."
              },
              {
                "name": "result_tag",
                "wave": "x.....=..x",
                "data": [
                  "same tag"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}

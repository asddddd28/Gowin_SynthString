                "wave": "0.10."
              },
              {
                "name": "audio_valid",
                "wave": "0...."
              },
              {
                "name": "completion_valid",
                "wave": "0..10"
              },
              {
                "name": "mutation_at_edge",
                "wave": "0.10."
              }
            ]
          }
        }
      ],

{
  "modules": [
    {
      "name": "AxisEnvelopeMulti",
      "rtl_path": "rtl/AxisEnvelopeMulti.v",
      "description": "四目标线性包络，事件/阶段管理复用段步进核。",
      "interfaces": {
        "ports": [
          {
            "name": "i_axis_aclk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "共用计算时钟"
          },
          {
            "name": "i_axis_arstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "异步清除资格，外部同步释放"
          },
          {
            "name": "i_s_axis_tdata",
            "direction": "input",
            "width": 320,
            "role": "data",
            "description": "本次任务的状态与参数"
          },
          {
            "name": "i_s_axis_tuser",
            "direction": "input",
            "width": 32,
            "role": "data",
            "description": "透明事务编号"
          },
          {
            "name": "i_s_axis_tvalid",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "源端有效资格"
          },
          {
            "name": "o_s_axis_tready",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "入口可接纳"
          },
          {
            "name": "o_m_axis_tdata",
            "direction": "output",
            "width": 64,
            "role": "data",
            "description": "完成结果"
          },
          {
            "name": "o_m_axis_tuser",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "原请求编号"
          },
          {
            "name": "o_m_axis_tvalid",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "完成资格"
          },
          {
            "name": "i_m_axis_tready",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "下游接受完成"
          }
        ]
      },
      "clock": {
        "name": "i_axis_aclk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_axis_arstn",
        "active": "low",
        "style": "asynchronous"
      },
      "behavior": [
        "E0 accept, earliest E6 consumption without stalls; II=1.",
        "States 0 idle,1/2/3 movement,4 hold,5 release; invalid 6/7 flagged and idled.",
        "Events 0 tick,1 note-on,2 note-off,3 kill; restart bit selects level L4 on note-on.",
        "One state transition per task; no automatic loop through equal targets in same sample.",
        "All persistent state belongs to caller; not a DX7 rate/curve implementation."
      ],
      "constraints": [
        "Candidate subsystem; existing board top unchanged; no Gowin timing/area claim.",
        "Common core clock only, no CDC. Caller provides synchronous reset release.",
        "AXI endpoint is a slave; it does not fetch RAM itself or implement a program scheduler."
      ],
      "corner_cases": [
        "backpressure and bubbles",
        "full and empty queues",
        "reset with in-flight tasks",
        "invalid stage or operation or bus request"
      ],
      "verification_cases": [
        "independent integer reference",
        "mixed tagged transactions and all sideband stability",
        "event/phase transition sequence",
        "AXI IDs, independent channels, WSTRB, bursts and FIFO side effects"
      ],
      "timing_diagrams": [
        {
          "id": "flow",
          "title": "任务提交与结果保持",
          "scenario": "flow",
          "description": "输入握手移交所有权；结果等待消费时数据和事务身份保持。精确延迟以行为合同为准。",
          "wavejson": {
            "signal": [
              {
                "name": "clock",
                "wave": "p........."
              },
              {
                "name": "request",
                "wave": "01.0......"
              },
              {
                "name": "processing",
                "wave": "01....0..."
              },
              {
                "name": "result_valid",
                "wave": "0.....1..0"
              },
              {
                "name": "result_ready",
                "wave": "1.....0.1."
              },
              {
                "name": "result_tag",
                "wave": "x.....=..x",
                "data": [
                  "same tag"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}

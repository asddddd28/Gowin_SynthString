{
  "modules": [
    {
      "name": "AxisSynthSystem",
      "rtl_path": "rtl/AxisSynthSystem.v",
      "description": "兼容旧任务的内部互联与持续采样时钟、PCM 队列。",
      "interfaces": {
        "ports": [
          {
            "name": "i_axis_aclk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "任务与结果共用时钟"
          },
          {
            "name": "i_axis_arstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "异步清除有效资格；外部同步释放"
          },
          {
            "name": "i_s_axis_tdata",
            "direction": "input",
            "width": 384,
            "role": "data",
            "description": "本次操作的状态与参数原子快照"
          },
          {
            "name": "i_s_axis_tuser",
            "direction": "input",
            "width": 32,
            "role": "data",
            "description": "调用者的透明事务编号"
          },
          {
            "name": "i_s_axis_tvalid",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "源端持有完整请求"
          },
          {
            "name": "o_s_axis_tready",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "本拍可以接收快照"
          },
          {
            "name": "o_m_axis_tdata",
            "direction": "output",
            "width": 128,
            "role": "data",
            "description": "该事务的数值和状态结果"
          },
          {
            "name": "o_m_axis_tuser",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "与结果同步返回的原编号"
          },
          {
            "name": "o_m_axis_tvalid",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "输出寄存器包含可消费事务"
          },
          {
            "name": "i_m_axis_tready",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "调用者可以提交输出结果"
          },
          {
            "name": "i_s_axis_tdest",
            "direction": "input",
            "width": 8,
            "role": "data",
            "description": "任务目的操作码"
          },
          {
            "name": "i_s_axis_tlast",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "原子命令边界"
          },
          {
            "name": "o_m_axis_tdest",
            "direction": "output",
            "width": 8,
            "role": "data",
            "description": "完成操作码"
          },
          {
            "name": "o_m_axis_tlast",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "完成均为单拍"
          },
          {
            "name": "o_count_executed",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "旧上下文计数"
          },
          {
            "name": "o_count_replayed",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "旧上下文计数"
          },
          {
            "name": "o_count_rejected",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "旧上下文计数"
          },
          {
            "name": "o_count_bound",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "旧上下文计数"
          },
          {
            "name": "o_pcm_valid",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "PCM 队列有数据"
          },
          {
            "name": "i_pcm_ready",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "消费 PCM"
          },
          {
            "name": "o_pcm_data",
            "direction": "output",
            "width": 64,
            "role": "data",
            "description": "左右 Q26 采样"
          },
          {
            "name": "o_pcm_frame",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "对应完成帧"
          },
          {
            "name": "o_overruns",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "采样期限错过"
          },
          {
            "name": "o_pcm_dropped",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "PCM 队列满丢弃新帧"
          },
          {
            "name": "o_render_cycles",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "最近渲染周期"
          },
          {
            "name": "o_active",
            "direction": "output",
            "width": 8,
            "role": "data",
            "description": "活动声部位图"
          },
          {
            "name": "o_fx_frames",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "FX处理帧数"
          },
          {
            "name": "o_fx_clipped",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "FX削波帧数"
          },
          {
            "name": "o_fx_dropped",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "FX输入丢帧数"
          },
          {
            "name": "o_fx_cycles",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "FX处理时钟数"
          },
          {
            "name": "i_touch_gain",
            "direction": "input",
            "width": 18,
            "role": "data",
            "description": "i_touch_gain"
          },
          {
            "name": "i_touch_pitch",
            "direction": "input",
            "width": 32,
            "role": "data",
            "description": "i_touch_pitch"
          },
          {
            "name": "i_touch_cutoff",
            "direction": "input",
            "width": 20,
            "role": "data",
            "description": "i_touch_cutoff"
          },
          {
            "name": "i_touch_cutoff_active",
            "direction": "input",
            "width": 1,
            "role": "data",
            "description": "i_touch_cutoff_active"
          }
        ]
      },
      "clock": {
        "name": "i_axis_aclk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_axis_arstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "Single-beat A0..A9 and B0..B3 route to the resident engine; C0..C4 route to the independent shared FX domain.",
        "LEGACY_ENABLE defaults to one for compatibility; the AxiSynthEndpoint wrapper sets zero and returns unsupported status 1 to old raw/context commands.",
        "Malformed packet head and tails remain in the legacy drain domain.",
        "Two-entry ingress queue adapts voice PCM pulses to AxisFxEngine; Delay then Reverb own shared tail state; output FIFO full drops new frames without freezing feedback.",
        "Sample tick every 1024 clocks; PCM full drops new frame and increments telemetry without blocking synthesis.",
        "完成通道含输出槽与备用槽，各保存 168 位 opcode/tag/result；备用有效必然意味着输出槽有效。上游接收仅依赖本地备用槽有效位和轮询选择，不组合依赖 i_m_axis_tready。",
        "轮询顺序为 Legacy → Voice → FX，初始优先 Legacy；仅在实际接收完成包时推进优先级。每个源在 VALID && READY 时提交。",
        "空队列接收后下一拍输出有效；只有输出槽有效时可同时出队与入队，连续 READY 下吞吐为每拍一包。输出暂停时数据与标签稳定。",
        "两槽全满时不允许同拍借用出队空间：本拍只出队、下拍恢复接收。该满载恢复边界产生一拍上游接收气泡，且不引入无反压场景的额外首包延迟。",
        "复位清空两个完成槽和轮询优先级，并取消所有在途完成包；PCM/FX 队列和音频计算状态机的时序保持原行为。",
        "C_DELAY_ADDR_BITS defaults15 in the library; board top uses13. Depth=2**bits, Q16.16 maximum delay=(depth<<16)-1; capability registers report actual depth. Supported board configurations13/14/15.",
        "C_FX_ENABLE编译期选择；整板SynthSystemTop默认0，内核默认1保留回归。关闭时不实例化Delay/Reverb，Voice PCM直接进入原四项PCM队列，FX能力/容量/遥测为0，C0..C4通过不支持完成路径返回状态1。开机使用剔除FX命令的boot_dry.hex，正常音色、键床、UART及音频频率不变。",
        "D0/D1 filter completion shares FX arbitration lane independently of optionalDelay/Reverb. Global lowpass aftervoice/FX beforePCMqueue; adds30clocks toframe path; missed filterinput increments pcm_dropped.",
        "C_TOUCH_ENABLE默认0，透传注册的硬件触摸调制源到Voice和Lowpass；AXI继续管理基础参数和音色程序。开启触摸的AxiVoiceEndpoint报告ABI1.7，否则保持1.6。"
      ],
      "constraints": [
        "Single 50 MHz clock domain; reset cancels in-flight work.",
        "See ENGINE.md for exact fixed-point and command ABI.",
        "Candidate: board timing and strict style gate are separate from functional simulation."
      ],
      "corner_cases": [
        "signed minima/maxima and zero",
        "changing tags and parameters every accepted beat",
        "long backpressure and bubbles",
        "reset while pipeline holds transactions"
      ],
      "verification_cases": [
        "Independent Python integer model versus xsim",
        "Backpressure stability and reset cancellation",
        "Illegal parameters and voice lifecycle",
        "1024-clock frame deadline under eight voices and six operators",
        "tb_completion_isolation：受控三源、独立队列计分板、长暂停、满载恢复、同时入出、满队列复位、轮询公平性和无时钟 READY 翻转隔离检查；实际 DSP 行为由整链测试另行覆盖。",
        "tb_axi_fx / tb_axi_voice_endpoint / tb_axi_synth_engine / tb_axi_lfo / tb_synth_system：真实子模块、AXI 回读、整数 PCM 参考模型和 1024 拍期限回归。",
        "关闭FX的整板启动、真实键床/UART、不支持命令和重放、PCM/PT8211一致性；保留FX配置兼容回归。"
      ],
      "timing_diagrams": [
        {
          "id": "touch",
          "title": "触摸事件与调制提交",
          "scenario": "touch",
          "description": "触摸采集在系统域提交，调制每毫秒平滑；音频帧独立执行，NoteOff确认之后才重新起音。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p........."
              },
              {
                "name": "position_update",
                "wave": "010...10.."
              },
              {
                "name": "control_tick",
                "wave": "0..10...10"
              },
              {
                "name": "audio_frame",
                "wave": "0101010101"
              },
              {
                "name": "row_noteoff",
                "wave": "0..10....."
              },
              {
                "name": "keys_idle_ack",
                "wave": "0.....10.."
              },
              {
                "name": "row_noteon",
                "wave": "0......10."
              }
            ]
          }
        }
      ],
      "parameters": [
        {
          "name": "LEGACY_ENABLE",
          "default": 1,
          "description": "启用旧上下文执行器；板级 AxiSynthEndpoint 设为 0。"
        },
        {
          "name": "C_DELAY_ADDR_BITS",
          "default": 15,
          "description": "Delay 环形 RAM 地址位数；当前板级设为 13。"
        }
      ]
    }
  ]
}
{
  "modules": [
    {
      "name": "tb_fm_interpolation",
      "rtl_path": "sim/tb_fm_interpolation.v",
      "description": "真实FM算子插值流水的满位宽边界、十拍延迟与事务取消验证。",
      "interfaces": {
        "ports": [
          {
            "name": "o_done",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "全部自检通过置1；内部提供时钟与刺激。"
          }
        ]
      },
      "parameters": [],
      "clock": {
        "name": "clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "初始复位，并分别在state1..10取消在途请求；波表内容保持。"
      },
      "behavior": [
        "接口上传2048个signed32边界样点，无force；Python整数参考生成960个独立请求/结果。",
        "fraction含0/1/半程邻点/最大值，地址含1023到0的回绕，morph覆盖0/65536及越界钳位。",
        "计算请求与波表写同时出现时计算优先；计算及输出反压期间写不得生效。",
        "每次结果必须在10拍出现，全部五个返回word及tag逐位核对；反压期间输出不变。",
        "分别在state1..10复位，检查无幽灵结果；每次随后执行新请求，末尾重查首样点确认被拒绝的写没有污染波表。"
      ],
      "constraints": [
        "功能时钟50MHz；真实物理时序另由Gowin完整STA证明。",
        "测试覆盖声明的状态和边界，不宣称形式等价或全部参数穷举。"
      ],
      "corner_cases": [
        "signed32极值、负数算术右移、波表地址回绕、morph钳位、反压、逐拍复位。"
      ],
      "verification_cases": [
        "971个完成结果、10个复位取消点、全部返回延迟10拍。",
        "主算子通用/DX参考向量和全链整数音频回归另外覆盖。"
      ],
      "timing_diagrams": [
        {
          "id": "interpolation_pipeline",
          "title": "插值乘法寄存与十拍调度",
          "scenario": "interpolation_pipeline",
          "description": "采样沿接纳请求后逐状态执行；EG未就绪则在state6等待。标称EG无额外等待，结果在state10有效。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p............."
              },
              {

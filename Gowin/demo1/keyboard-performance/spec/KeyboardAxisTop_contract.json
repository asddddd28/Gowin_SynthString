{
  "modules": [
    {
      "name": "KeyboardAxisTop",
      "rtl_path": "src/KeyboardAxisTop.v",
      "description": "50MHz单域，1024拍音频帧，采样率48828.125Hz，相位增量按此采样率计算。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "direction": "input",
            "description": "50MHz统一计算时钟",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "direction": "input",
            "description": "低有效复位，异步置位同步释放",
            "role": "reset"
          },
          {
            "name": "i_adc_dout",
            "width": 1,
            "direction": "input",
            "description": "外部ADC串行数据",
            "role": "data"
          },
          {
            "name": "i_uart_rx",
            "width": 1,
            "direction": "input",
            "description": "调试命令输入",
            "role": "data"
          },
          {
            "name": "o_mux_sel",
            "width": 3,
            "direction": "output",
            "description": "模拟多路选择",
            "role": "data"
          },
          {
            "name": "o_mux_en",
            "width": 1,
            "direction": "output",
            "description": "多路器使能",
            "role": "data"
          },
          {
            "name": "o_adc_cs_n",
            "width": 1,
            "direction": "output",
            "description": "ADC片选",
            "role": "data"
          },
          {
            "name": "o_adc_sclk",
            "width": 1,
            "direction": "output",
            "description": "ADC时钟",
            "role": "data"
          },
          {
            "name": "o_adc_din",
            "width": 1,
            "direction": "output",
            "description": "ADC命令",
            "role": "data"
          },
          {
            "name": "o_uart_tx",
            "width": 1,
            "direction": "output",
            "description": "调试快照",
            "role": "data"
          },
          {
            "name": "HP_BCK",
            "width": 1,
            "direction": "output",
            "description": "PT8211位时钟",
            "role": "data"
          },
          {
            "name": "HP_WS",
            "width": 1,
            "direction": "output",
            "description": "PT8211声道选择",
            "role": "data"
          },
          {
            "name": "HP_DIN",
            "width": 1,
            "direction": "output",
            "description": "PT8211音频数据",
            "role": "data"
          },
          {
            "name": "PA_EN",
            "width": 1,
            "direction": "output",
            "description": "低有效功放使能",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 20
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "取消事件和任务，键状态及计数清零"
      },
      "behavior": [
        "50MHz单域，1024拍音频帧，采样率48828.125Hz，相位增量按此采样率计算。",
        "真实ADC双转换扫描，门限判键，376位完整参数握手，32声部AXIS，16位PT8211。",
        "配置初始化完成后才启动音频；功放延时打开，fault或overrun时关闭。",
        "UART T产生有标记的一秒C4数字自测，P结束自测；不改物理按键状态。",
        "固定正弦和ADSR音色；本次不实现App音色编辑、SD加载或任意任务图。",
        "命令0至8设置主音量，默认6；ADSR释音仍计入发声数，按4/sqrt(N)及音量缩放，增益变化平滑。",
        "输出经四拍响度流水后送入PT8211，64字节遥测包含电平、增益和限幅。"
      ],
      "constraints": [
        "固定32个逻辑声部；50MHz；板型31004；只用于本轮SRAM诊断验证。"
      ],
      "corner_cases": [
        "复位后按住键",
        "门限附近抖动",
        "事件遇到音频忙帧",
        "多个键同时变化"
      ],
      "verification_cases": [
        "上电静音",
        "跨行多键按下和释放",
        "ADC至DAC引脚解码",
        "配置反压保持",
        "命令自测与物理键隔离"
      ],
      "timing_diagrams": [
        {
          "id": "flow",
          "title": "接口概念时序",
          "scenario": "pipeline",
          "description": "为事件顺序示意，间隔不按比例；实际周期见仿真与构建报告。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p......."
              },
              {
                "name": "adc_valid",
                "wave": "01010..."
              },
              {
                "name": "key_on",
                "wave": "0..1...."
              },
              {
                "name": "cfg_transfer",
                "wave": "0...10.."
              },
              {
                "name": "pcm",
                "wave": "0.....10"
              }
            ]
          }
        }
      ]
    }
  ]
}
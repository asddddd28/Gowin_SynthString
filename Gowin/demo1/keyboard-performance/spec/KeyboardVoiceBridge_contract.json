{
  "modules": [
    {
      "name": "KeyboardVoiceBridge",
      "rtl_path": "src/KeyboardVoiceBridge.v",
      "description": "启动依次初始化32个独立逻辑声部，全部接受后允许音频运行。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "direction": "input",
            "description": "50MHz统一计算时钟",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "direction": "input",
            "description": "低有效复位，异步置位同步释放",
            "role": "reset"
          },
          {
            "name": "i_pressed",
            "width": 32,
            "direction": "input",
            "description": "目标键状态",
            "role": "data"
          },
          {
            "name": "i_frame_done",
            "width": 1,
            "direction": "input",
            "description": "PCM完成脉冲",
            "role": "data"
          },
          {
            "name": "o_cfg_valid",
            "width": 1,
            "direction": "output",
            "description": "完整配置有效",
            "role": "data"
          },
          {
            "name": "i_cfg_ready",
            "width": 1,
            "direction": "input",
            "description": "引擎接受配置",
            "role": "data"
          },
          {
            "name": "o_cfg_voice",
            "width": 5,
            "direction": "output",
            "description": "目标逻辑声部",
            "role": "data"
          },
          {
            "name": "o_cfg_data",
            "width": 376,
            "direction": "output",
            "description": "完整参数和单次事件",
            "role": "data"
          },
          {
            "name": "o_initialized",
            "width": 1,
            "direction": "output",
            "description": "全部初始配置已接受",
            "role": "data"
          },
          {
            "name": "o_delivered",
            "width": 32,
            "direction": "output",
            "description": "最后接受的键状态",
            "role": "data"
          },
          {
            "name": "o_events",
            "width": 32,
            "direction": "output",
            "description": "已接受事件计数",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 20
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "取消事件和任务，键状态及计数清零"
      },
      "behavior": [
        "启动依次初始化32个独立逻辑声部，全部接受后允许音频运行。",
        "按键0至31对应MIDI48至79；此版按键对应逻辑声部，运算器仍共享。",
        "配置保持到valid和ready同时有效；事件为重触发或释音。",
        "运行中每次配置接受后等待该音频帧PCM完成，避免同声部单槽事件被提前覆盖。"
      ],
      "constraints": [
        "固定32个逻辑声部；50MHz；板型31004；只用于本轮SRAM诊断验证。"
      ],
      "corner_cases": [
        "复位后按住键",
        "门限附近抖动",
        "事件遇到音频忙帧",
        "多个键同时变化"
      ],
      "verification_cases": [
        "上电静音",
        "跨行多键按下和释放",
        "ADC至DAC引脚解码",
        "配置反压保持",
        "命令自测与物理键隔离"
      ],
      "timing_diagrams": [
        {
          "id": "flow",
          "title": "接口概念时序",
          "scenario": "pipeline",
          "description": "为事件顺序示意，间隔不按比例；实际周期见仿真与构建报告。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p......."
              },
              {
                "name": "key",
                "wave": "01......"
              },
              {
                "name": "cfg_valid",
                "wave": "0.1..0.."
              },
              {
                "name": "cfg_ready",
                "wave": "0...10.."
              },
              {
                "name": "frame_done",
                "wave": "0.....10"
              }
            ]
          }
        }
      ]
    }
  ]
}
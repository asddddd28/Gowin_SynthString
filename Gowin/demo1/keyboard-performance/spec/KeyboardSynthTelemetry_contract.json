{
  "modules": [
    {
      "name": "KeyboardSynthTelemetry",
      "rtl_path": "src/KeyboardSynthTelemetry.v",
      "description": "周期性锁存32字节原子状态快照，计算前30字节异或，最后字节0D。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "direction": "input",
            "description": "50MHz统一计算时钟",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "direction": "input",
            "description": "低有效复位，异步置位同步释放",
            "role": "reset"
          },
          {
            "name": "i_frames",
            "width": 32,
            "direction": "input",
            "description": "音频帧计数",
            "role": "data"
          },
          {
            "name": "i_pressed",
            "width": 32,
            "direction": "input",
            "description": "物理键状态",
            "role": "data"
          },
          {
            "name": "i_delivered",
            "width": 32,
            "direction": "input",
            "description": "提交键状态",
            "role": "data"
          },
          {
            "name": "i_nonzero",
            "width": 32,
            "direction": "input",
            "description": "非零PCM计数",
            "role": "data"
          },
          {
            "name": "i_events",
            "width": 32,
            "direction": "input",
            "description": "事件计数",
            "role": "data"
          },
          {
            "name": "i_cycles",
            "width": 16,
            "direction": "input",
            "description": "合成周期",
            "role": "data"
          },
          {
            "name": "i_flags",
            "width": 8,
            "direction": "input",
            "description": "错误及测试标志",
            "role": "data"
          },
          {
            "name": "i_key",
            "width": 5,
            "direction": "input",
            "description": "最近键号",
            "role": "data"
          },
          {
            "name": "i_raw",
            "width": 12,
            "direction": "input",
            "description": "最近ADC结果",
            "role": "data"
          },
          {
            "name": "o_uart_tx",
            "width": 1,
            "direction": "output",
            "description": "115200 8N1输出",
            "role": "data"
          },
          {
            "name": "i_volume",
            "width": 4,
            "direction": "input",
            "description": "主音量0至8",
            "role": "data"
          },
          {
            "name": "i_active_count",
            "width": 6,
            "direction": "input",
            "description": "ADSR非空闲声部数，包括释音",
            "role": "data"
          },
          {
            "name": "i_gain",
            "width": 19,
            "direction": "input",
            "description": "平滑后的Q16增益",
            "role": "data"
          },
          {
            "name": "i_input_peak",
            "width": 24,
            "direction": "input",
            "description": "处理前采样峰值保持",
            "role": "data"
          },
          {
            "name": "i_output_peak",
            "width": 24,
            "direction": "input",
            "description": "处理后采样峰值保持",
            "role": "data"
          },
          {
            "name": "i_clips",
            "width": 32,
            "direction": "input",
            "description": "保护限幅累计次数",
            "role": "data"
          },
          {
            "name": "i_stages",
            "width": 7,
            "direction": "input",
            "description": "已提交阶段累计位图",
            "role": "data"
          },
          {
            "name": "i_wave_peak",
            "width": 32,
            "direction": "input",
            "description": "振荡波形绝对峰值",
            "role": "data"
          },
          {
            "name": "i_mod_peak",
            "width": 32,
            "direction": "input",
            "description": "AM输出绝对峰值",
            "role": "data"
          },
          {
            "name": "i_env_peak",
            "width": 18,
            "direction": "input",
            "description": "包络整数峰值",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 20
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "取消事件和任务，键状态及计数清零"
      },
      "behavior": [
        "周期锁存64字节快照；头A5 5A 02 40，0至61字节XOR写62，63字节0D。",
        "0至29字节沿用旧状态布局，30音量，31声部数，32增益，36输入峰值，40输出峰值，44限幅计数，48包络峰值，52波形峰值，56调制峰值，60阶段位图，61音量副本。",
        "多字节整数小端；发完整包后才重新锁存，等待UART停止位。"
      ],
      "constraints": [
        "固定32个逻辑声部；50MHz；板型31004；只用于本轮SRAM诊断验证。"
      ],
      "corner_cases": [
        "复位后按住键",
        "门限附近抖动",
        "事件遇到音频忙帧",
        "多个键同时变化"
      ],
      "verification_cases": [
        "上电静音",
        "跨行多键按下和释放",
        "ADC至DAC引脚解码",
        "配置反压保持",
        "命令自测与物理键隔离"
      ],
      "timing_diagrams": [
        {
          "id": "flow",
          "title": "接口概念时序",
          "scenario": "pipeline",
          "description": "为事件顺序示意，间隔不按比例；实际周期见仿真与构建报告。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p......."
              },
              {
                "name": "snapshot",
                "wave": "010....."
              },
              {
                "name": "checksum",
                "wave": "0.1.0..."
              },
              {
                "name": "uart_busy",
                "wave": "0...1..0"
              }
            ]
          }
        }
      ]
    }
  ]
}
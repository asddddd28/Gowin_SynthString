{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tang Synth Studio",
  "version": "0.4.0",
  "identifier": "com.tangsynth.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main", "title":"Tang Synth Studio", "width":1440,"height":940,"minWidth":1080,"minHeight":720,"center":true,"backgroundColor":"#101211"}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {"assets/":"assets/"},
    "icon": ["icons/icon.ico"]
  }
}

{
  "modules": [
    {
      "name": "ParallelAudioSystem",
      "rtl_path": "src/ParallelAudioSystem.v",
      "description": "将核心数量参数传递到ParallelSynthEngine；保持旧Studio协议及定点精度。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "description": "统一计算时钟",
            "direction": "input",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "description": "全系统低有效复位，释放须同步",
            "direction": "input",
            "role": "reset"
          },
          {
            "name": "i_run",
            "width": 1,
            "description": "配置结束后启动音频；只在空闲时停止",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_valid",
            "width": 1,
            "description": "源端持有完整声部配置",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_cfg_ready",
            "width": 1,
            "description": "仅空闲帧接收配置",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_cfg_voice",
            "width": 5,
            "description": "目标声部索引",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_data",
            "width": 512,
            "description": "音色参数和一次性门控事件",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_valid",
            "width": 1,
            "description": "波表上传字有效",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_wave_ready",
            "width": 1,
            "description": "空闲时允许更新波表",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_wave_frame",
            "width": 1,
            "description": "选择波表的A或B帧",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_address",
            "width": 11,
            "description": "银行位及1024点地址",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_data",
            "width": 16,
            "description": "有符号波表采样",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_pcm_valid",
            "width": 1,
            "description": "完整混音帧可消费",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_pcm_left",
            "width": 24,
            "description": "限幅后的左声道PCM",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_pcm_right",
            "width": 24,
            "description": "首版复制单声道到右声道",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_busy",
            "width": 1,
            "description": "当前音频帧尚未完全退役",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_overrun",
            "width": 1,
            "description": "忙时采样触发丢失的粘滞标志",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_fault",
            "width": 1,
            "description": "返回身份或算法错误，需要复位",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_frame_cycles",
            "width": 16,
            "description": "最近完成帧的计算周期数",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_valid",
            "width": 1,
            "description": "一个有效声部尾部结果提交",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_voice",
            "width": 5,
            "description": "本次提交所属声部",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_data",
            "width": 192,
            "description": "完整音频与滤波新状态",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_sample_tick",
            "width": 1,
            "description": "音频帧节拍监测",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_bclk",
            "width": 1,
            "description": "串行位时钟",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_lrclk",
            "width": 1,
            "description": "左右声道选择",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_sdata",
            "width": 1,
            "description": "I2S音频输出",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_mclk",
            "width": 1,
            "description": "主音频时钟",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_underrun",
            "width": 1,
            "description": "I2S缺帧粘滞标志",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_volume",
            "width": 4,
            "direction": "input",
            "description": "主音量0至8",
            "role": "data"
          },
          {
            "name": "o_active_count",
            "width": 6,
            "direction": "output",
            "description": "ADSR非空闲声部数，包括释音",
            "role": "data"
          },
          {
            "name": "o_gain",
            "width": 19,
            "direction": "output",
            "description": "平滑后的Q16增益",
            "role": "data"
          },
          {
            "name": "o_input_peak",
            "width": 24,
            "direction": "output",
            "description": "处理前采样峰值保持",
            "role": "data"
          },
          {
            "name": "o_output_peak",
            "width": 24,
            "direction": "output",
            "description": "处理后采样峰值保持",
            "role": "data"
          },
          {
            "name": "o_clips",
            "width": 32,
            "direction": "output",
            "description": "保护限幅累计次数",
            "role": "data"
          },
          {
            "name": "o_stages",
            "width": 7,
            "direction": "output",
            "description": "已提交阶段累计位图",
            "role": "data"
          },
          {
            "name": "o_wave_peak",
            "width": 32,
            "direction": "output",
            "description": "振荡波形绝对峰值",
            "role": "data"
          },
          {
            "name": "o_mod_peak",
            "width": 32,
            "direction": "output",
            "description": "AM输出绝对峰值",
            "role": "data"
          },
          {
            "name": "o_env_peak",
            "width": 18,
            "direction": "output",
            "description": "包络整数峰值",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 10
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "全局清除任务、相位包络滤波状态，保留波表RAM；外部同步释放"
      },
      "behavior": [
        "将核心数量参数传递到ParallelSynthEngine；保持旧Studio协议及定点精度。",
        "板级50MHz/1024=48828.125Hz；引擎提前算完不会提前改变PT8211串行采样节拍。",
        "32声部混音后按活动包络数进行响度补偿、平滑主音量、限幅及16位舍入输出；左右声道复制。"
      ],
      "constraints": [
        "50MHz同一时钟域，低有效复位；板级复位同步释放。",
        "C_*_CORES是综合期参数，1..4；任意配置需要独立验证资源和时序，只有默认配置有本板实现证据。",
        "一个issue和一个retire端口；仍保留阶段屏障，不是任意连接的多发射计算图。"
      ],
      "corner_cases": [
        "全满背压及同时接受/返回",
        "非2次幂核心数游标回绕",
        "处理中复位",
        "wave副本写一致性",
        "note-off保留旧参数"
      ],
      "verification_cases": [
        "原引擎逐声部及PCM等值比较",
        "各池1/2/3/4核配置",
        "输入输出停顿及复位",
        "真实ADC/UART/PT8211引脚闭环",
        "Gowin综合与50MHz时序"
      ],
      "timing_diagrams": [
        {
          "id": "ordered",
          "title": "背压与有序返回",
          "scenario": "handshake",
          "description": "示意ready为0时保持队首；箭头不代表固定核心算术延迟。实际周期见各核心和阶段统计。",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......."
              },
              {
                "name": "valid",
                "wave": "01...0.."
              },
              {
                "name": "ready",
                "wave": "0...10.."
              },
              {
                "name": "task",
                "wave": "x2...x..",
                "data": [
                  "voice n"
                ]
              },
              {
                "name": "accept",
                "wave": "0...10.."
              }
            ]
          }
        }
      ]
    }
  ]
}
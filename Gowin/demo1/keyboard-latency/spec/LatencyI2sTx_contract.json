      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 20
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "取消事件和任务，键状态及计数清零"
      },
      "behavior": [
        "沿用原PT8211/I2S音频位流、舍入和待播放缓冲；观察口不影响功能。",
        "o_frame_load在真实帧边界且有新PCM可加载时有效，含同拍旁路。",
        "PT8211模式下o_dac_left_latch在cnt_frame=512-C_FRAME_STEP且该播放帧有效时有效；这个沿使WS从高转低。",
        "板级只使用PT8211、C_FRAME_STEP=1；锁存是数字终点，不代表模拟输出无额外延迟。"
      ],
      "constraints": [
        "50MHz同一时钟域，异步低有效复位，顶层同步释放。",
        "监测无音频控制反馈；一次事件窗口小于32位时间戳周期，默认1秒超时。"
      ],
      "corner_cases": [
        "32键同时完成",
        "计数回绕",
        "候选取消",
        "静音与慢起音",
        "覆盖与超时并发",
        "清零时仍按住键"
      ],
      "verification_cases": [
        "独立时间差模型",
        "逐分段确定值比较",
        "真实ADC和PT8211 WS边沿关联",
        "协议4全部分包边界及坏包恢复",
        "Gowin时序与板上串口/听感"
      ],

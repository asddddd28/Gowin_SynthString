{
  "modules": [
    {
      "name": "KeyboardSynthEngine",
      "rtl_path": "src/KeyboardSynthEngine.v",
      "description": "七阶段交错调度、身份校验和多声部状态回写",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "description": "统一计算时钟",
            "direction": "input",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "description": "全系统低有效复位，释放须同步",
            "direction": "input",
            "role": "reset"
          },
          {
            "name": "i_start",
            "width": 1,
            "description": "请求计算下一音频帧，忙时拒收并记过载",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_valid",
            "width": 1,
            "description": "源端持有完整声部配置",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_cfg_ready",
            "width": 1,
            "description": "仅空闲帧接收配置",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_cfg_voice",
            "width": 5,
            "description": "目标声部索引",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_data",
            "width": 512,
            "description": "音色参数和一次性门控事件",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_valid",
            "width": 1,
            "description": "波表上传字有效",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_wave_ready",
            "width": 1,
            "description": "空闲时允许更新波表",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_wave_frame",
            "width": 1,
            "description": "选择波表的A或B帧",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_address",
            "width": 11,
            "description": "银行位及1024点地址",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_data",
            "width": 16,
            "description": "有符号波表采样",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_pcm_valid",
            "width": 1,
            "description": "完整混音帧可消费",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_pcm_ready",
            "width": 1,
            "description": "音频出口消费当前帧",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_pcm_left",
            "width": 24,
            "description": "限幅后的左声道PCM",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_pcm_right",
            "width": 24,
            "description": "首版复制单声道到右声道",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_busy",
            "width": 1,
            "description": "当前音频帧尚未完全退役",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_overrun",
            "width": 1,
            "description": "忙时采样触发丢失的粘滞标志",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_fault",
            "width": 1,
            "description": "返回身份或算法错误，需要复位",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_frame_cycles",
            "width": 16,
            "description": "最近完成帧的计算周期数",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_valid",
            "width": 1,
            "description": "一个有效声部尾部结果提交",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_voice",
            "width": 5,
            "description": "本次提交所属声部",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_data",
            "width": 192,
            "description": "完整音频与滤波新状态",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_active",
            "width": 32,
            "direction": "output",
            "description": "实际ADSR非空闲位图",
            "role": "data"
          },
          {
            "name": "o_stages",
            "width": 7,
            "direction": "output",
            "description": "已接受阶段位图",
            "role": "data"
          },
          {
            "name": "o_wave_peak",
            "width": 32,
            "direction": "output",
            "description": "振荡峰值",
            "role": "data"
          },
          {
            "name": "o_mod_peak",
            "width": 32,
            "direction": "output",
            "description": "AM峰值",
            "role": "data"
          },
          {
            "name": "o_env_peak",
            "width": 18,
            "direction": "output",
            "description": "包络峰值",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 10
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "全局清除任务、相位包络滤波状态，保留波表RAM；外部同步释放"
      },
      "behavior": [
        "八阶段顺序7→0→1→2→3→4→5→6：调制包络、B相位、B波形、A相位FM、A波形、振幅包络、混合AM、SVF/VCA。",
        "每次新声部等待两拍同步RAM预取及调制深度乘法，然后发射带票据任务。",
        "32声部共享计算核心，下一阶段等待所有当前阶段结果返回；RAM写回增加一拍，由预取等待覆盖。",
        "事件消费位于振幅包络阶段；活动声部计数仅取振幅包络，包含release。"
      ],
      "constraints": [
        "50MHz单时钟域；异步低有效复位，板级同步释放。",
        "新固件协议与旧96kHz Studio不兼容，必须核对版本3。"
      ],
      "corner_cases": [
        "复位取消旧任务",
        "输出背压",
        "32键复音",
        "CRC失败与残包",
        "参数在释音中更新"
      ],
      "verification_cases": [
        "完整ADC/UART/PT8211闭环",
        "400个混合整数向量",
        "配置ACK及短演奏包",
        "无覆盖的活动参数快照",
        "Gowin综合实现时序"
      ],
      "timing_diagrams": [
        {
          "id": "commit",
          "title": "参数与任务提交",
          "scenario": "handshake",
          "description": "有效期间保持完整事务，接受后才发射或确认；算术延迟见行为合同。",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......"
              },
              {
                "name": "valid",
                "wave": "01..0.."
              },
              {
                "name": "ready",
                "wave": "0..10.."
              },
              {
                "name": "commit",
                "wave": "0...10."
              }
            ]
          }
        }
      ]
    }
  ]
}
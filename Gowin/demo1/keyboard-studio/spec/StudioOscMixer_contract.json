          },
          {
            "name": "i_m_axis_tready",
            "width": 1,
            "direction": "input",
            "description": "i m axis tready",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_axis_aclk",
        "edge": "posedge",
        "period_ns": 20
      },
      "reset": {
        "name": "i_axis_arstn",
        "active": "low",
        "style": "asynchronous",
        "values": "取消事件和任务，键状态及计数清零"
      },
      "behavior": [
        "136位任务含Q26载波、调制源、深度、2位AM模式、mix开关、两个Q16音量。",
        "七拍算术：锁存、深度乘法、AM因子、载波乘法、两个音量乘法、混合、饱和。信用池持有票据并支持背压。",
        "混合模式A+B按总增益归一化；FM/AM/环形模式仅输出A，调制振荡器用于控制。"
      ],
      "constraints": [
        "50MHz单时钟域；异步低有效复位，板级同步释放。",
        "新固件协议与旧96kHz Studio不兼容，必须核对版本3。"
      ],
      "corner_cases": [
        "复位取消旧任务",
        "输出背压",
        "32键复音",
        "CRC失败与残包",
        "参数在释音中更新"
      ],
      "verification_cases": [
        "完整ADC/UART/PT8211闭环",
        "400个混合整数向量",
        "配置ACK及短演奏包",
        "无覆盖的活动参数快照",
        "Gowin综合实现时序"
      ],
      "timing_diagrams": [
        {
          "id": "commit",
          "title": "参数与任务提交",
          "scenario": "handshake",
          "description": "有效期间保持完整事务，接受后才发射或确认；算术延迟见行为合同。",
          "wavejson": {
            "signal": [
              {
                "name": "i_axis_aclk",
                "wave": "p......"
              },
              {
                "name": "valid",
                "wave": "01..0.."
              },
              {
                "name": "ready",
                "wave": "0..10.."
              },
              {
                "name": "commit",
                "wave": "0...10."
              }
            ]
          }
        }
      ]

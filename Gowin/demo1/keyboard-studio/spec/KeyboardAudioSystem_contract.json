{
  "modules": [
    {
      "name": "KeyboardAudioSystem",
      "rtl_path": "src/KeyboardAudioSystem.v",
      "description": "逻辑音频系统顶层：共享任务引擎到I2S双声道",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "width": 1,
            "description": "统一计算时钟",
            "direction": "input",
            "role": "clock"
          },
          {
            "name": "i_rstn",
            "width": 1,
            "description": "全系统低有效复位，释放须同步",
            "direction": "input",
            "role": "reset"
          },
          {
            "name": "i_run",
            "width": 1,
            "description": "配置结束后启动音频；只在空闲时停止",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_valid",
            "width": 1,
            "description": "源端持有完整声部配置",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_cfg_ready",
            "width": 1,
            "description": "仅空闲帧接收配置",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_cfg_voice",
            "width": 5,
            "description": "目标声部索引",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_cfg_data",
            "width": 512,
            "description": "音色参数和一次性门控事件",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_valid",
            "width": 1,
            "description": "波表上传字有效",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_wave_ready",
            "width": 1,
            "description": "空闲时允许更新波表",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_wave_frame",
            "width": 1,
            "description": "选择波表的A或B帧",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_address",
            "width": 11,
            "description": "银行位及1024点地址",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "i_wave_data",
            "width": 16,
            "description": "有符号波表采样",
            "direction": "input",
            "role": "data"
          },
          {
            "name": "o_pcm_valid",
            "width": 1,
            "description": "完整混音帧可消费",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_pcm_left",
            "width": 24,
            "description": "限幅后的左声道PCM",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_pcm_right",
            "width": 24,
            "description": "首版复制单声道到右声道",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_busy",
            "width": 1,
            "description": "当前音频帧尚未完全退役",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_overrun",
            "width": 1,
            "description": "忙时采样触发丢失的粘滞标志",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_fault",
            "width": 1,
            "description": "返回身份或算法错误，需要复位",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_frame_cycles",
            "width": 16,
            "description": "最近完成帧的计算周期数",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_valid",
            "width": 1,
            "description": "一个有效声部尾部结果提交",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_voice",
            "width": 5,
            "description": "本次提交所属声部",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_result_data",
            "width": 192,
            "description": "完整音频与滤波新状态",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_sample_tick",
            "width": 1,
            "description": "音频帧节拍监测",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_bclk",
            "width": 1,
            "description": "串行位时钟",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_lrclk",
            "width": 1,
            "description": "左右声道选择",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_sdata",
            "width": 1,
            "description": "I2S音频输出",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_mclk",
            "width": 1,
            "description": "主音频时钟",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "o_underrun",
            "width": 1,
            "description": "I2S缺帧粘滞标志",
            "direction": "output",
            "role": "data"
          },
          {
            "name": "i_volume",
            "width": 4,
            "direction": "input",
            "description": "主音量0至8",
            "role": "data"
          },
          {
            "name": "o_active_count",
            "width": 6,
            "direction": "output",
            "description": "ADSR非空闲声部数，包括释音",
            "role": "data"
          },
          {
            "name": "o_gain",
            "width": 19,
            "direction": "output",
            "description": "平滑后的Q16增益",
            "role": "data"
          },
          {
            "name": "o_input_peak",
            "width": 24,
            "direction": "output",
            "description": "处理前采样峰值保持",
            "role": "data"
          },
          {
            "name": "o_output_peak",
            "width": 24,
            "direction": "output",
            "description": "处理后采样峰值保持",
            "role": "data"
          },
          {
            "name": "o_clips",
            "width": 32,
            "direction": "output",
            "description": "保护限幅累计次数",
            "role": "data"
          },
          {
            "name": "o_stages",
            "width": 7,
            "direction": "output",
            "description": "已提交阶段累计位图",
            "role": "data"
          },
          {
            "name": "o_wave_peak",
            "width": 32,
            "direction": "output",
            "description": "振荡波形绝对峰值",
            "role": "data"
          },
          {
            "name": "o_mod_peak",
            "width": 32,
            "direction": "output",
            "description": "AM输出绝对峰值",
            "role": "data"
          },
          {
            "name": "o_env_peak",
            "width": 18,
            "direction": "output",
            "description": "包络整数峰值",
            "role": "data"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "period_ns": 10
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "全局清除任务、相位包络滤波状态，保留波表RAM；外部同步释放"
      },
      "behavior": [
        "串联八阶段合成器、固定除32混音、1/sqrt(N)补偿与主音量、PT8211。",
        "采样率50000000/1024=48828.125Hz；PCM必须在下一帧开始前提交。",
        "左右声道复制单声道；波表写入仅在引擎空闲窗口接受。"
      ],
      "constraints": [
        "50MHz单时钟域；异步低有效复位，板级同步释放。",
        "新固件协议与旧96kHz Studio不兼容，必须核对版本3。"
      ],
      "corner_cases": [
        "复位取消旧任务",
        "输出背压",
        "32键复音",
        "CRC失败与残包",
        "参数在释音中更新"
      ],
      "verification_cases": [
        "完整ADC/UART/PT8211闭环",
        "400个混合整数向量",
        "配置ACK及短演奏包",
        "无覆盖的活动参数快照",
        "Gowin综合实现时序"
      ],
      "timing_diagrams": [
        {
          "id": "commit",
          "title": "参数与任务提交",
          "scenario": "handshake",
          "description": "有效期间保持完整事务，接受后才发射或确认；算术延迟见行为合同。",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......"
              },
              {
                "name": "valid",
                "wave": "01..0.."
              },
              {
                "name": "ready",
                "wave": "0..10.."
              },
              {
                "name": "commit",
                "wave": "0...10."
              }
            ]
          }
        }
      ]
    }
  ]
}
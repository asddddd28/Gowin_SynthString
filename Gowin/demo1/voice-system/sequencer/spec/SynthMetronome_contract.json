{
  "modules": [
    {
      "name": "SynthMetronome",
      "rtl_path": "rtl/SynthMetronome.v",
      "description": "i_click将DDS相位归零并设置重音/普通音幅度；i_sample每个PCM帧更新一次。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "i_rstn"
          },
          {
            "name": "i_sample",
            "direction": "input",
            "width": 1,
            "role": "data",
            "description": "i_sample"
          },
          {
            "name": "i_running",
            "direction": "input",
            "width": 1,
            "role": "data",
            "description": "i_running"
          },
          {
            "name": "i_click",
            "direction": "input",
            "width": 1,
            "role": "data",
            "description": "i_click"
          },
          {
            "name": "i_accent",
            "direction": "input",
            "width": 1,
            "role": "data",
            "description": "i_accent"
          },
          {
            "name": "o_sample",
            "direction": "output",
            "width": 16,
            "role": "data",
            "description": "o_sample"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "i_click将DDS相位归零并设置重音/普通音幅度；i_sample每个PCM帧更新一次。",
        "24位相位累加，1320/880Hz近似方波、一阶平滑及线性衰减；峰值限制1536/1024，不占用合成声部、DSP或RAM。",
        "i_running无效立即归零；独立固定低音量监听，未绑定用户主音量。声音路由最终经PCM饱和混音。"
      ],
      "constraints": [
        "50MHz单时钟；异步低有效复位。事件RAM无清零复位。参数C_ADDRESS_BITS为6..10，C_PPQ为1..1024，C_US_CYCLES为1..64。C_EARLY_WINDOW=1时C_PPQ至少32；正式板级PPQ=960，BPM20..300。"
      ],
      "corner_cases": [
        "不足一小节、边界同拍事件、截断长音、满缓存、背压清空、重复包、音色覆盖、暂停时现场键仍按住。"
      ],
      "verification_cases": [
        "sequence_model.py参考行为；tb_sequencer边界/叠录/背压。",
        "tb_sequencer_system真实ADC/UART/AXI/PT8211；UART重复包只翻转一次。"
      ],
      "timing_diagrams": [
        {
          "id": "record-play",
          "title": "小节提交与回放握手",
          "scenario": "record-play",
          "description": "按键事件暂存，停止后保留完成的小节；回放命令稳定等待仲裁和回执。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p........."
              },
              {
                "name": "record",
                "wave": "01....0..."
              },
              {
                "name": "bar_boundary",
                "wave": "0..10....."
              },
              {
                "name": "note_capture",
                "wave": "0.10.10..."
              },
              {
                "name": "committed",
                "wave": "0......1.."
              },
              {
                "name": "play_req",
                "wave": "0......1.."
              },
              {
                "name": "ready",
                "wave": "1......01."
              },
              {
                "name": "completion",
                "wave": "0........1"
              }
            ]
          }
        }
      ]
    }
  ]
}
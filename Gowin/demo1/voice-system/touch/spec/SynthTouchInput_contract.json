{
  "modules": [
    {
      "name": "SynthTouchInput",
      "rtl_path": "rtl/SynthTouchInput.v",
      "description": "两套原有MprScanner/I2cRegister/OpenCores I2C引擎分别采集两块MPR121，错误互不影响。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "i_rstn"
          },
          {
            "name": "io_scl",
            "direction": "inout",
            "width": 2,
            "role": "data",
            "description": "io_scl"
          },
          {
            "name": "io_sda",
            "direction": "inout",
            "width": 2,
            "role": "data",
            "description": "io_sda"
          },
          {
            "name": "o_update",
            "direction": "output",
            "width": 2,
            "role": "data",
            "description": "o_update"
          },
          {
            "name": "o_touch",
            "direction": "output",
            "width": 2,
            "role": "data",
            "description": "o_touch"
          },
          {
            "name": "o_x",
            "direction": "output",
            "width": 20,
            "role": "data",
            "description": "o_x"
          },
          {
            "name": "o_y",
            "direction": "output",
            "width": 20,
            "role": "data",
            "description": "o_y"
          },
          {
            "name": "o_error",
            "direction": "output",
            "width": 16,
            "role": "data",
            "description": "o_error"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "两套原有MprScanner/I2cRegister/OpenCores I2C引擎分别采集两块MPR121，错误互不影响。",
        "SCL/SDA为开漏，遵循demo_test引脚与初始化；无需IRQ，软件串口轮询不参与实时采集。",
        "每块接一套TouchPosition；位置和更新脉冲都在50MHz系统域。"
      ],
      "constraints": [
        "50MHz系统域；实时控制不依赖串口；ROM由touch_model.py生成。"
      ],
      "corner_cases": [
        "复位、数据过期、触点跳变、重复包、在途按键命令、方向与模式切换、空行。"
      ],
      "verification_cases": [
        "touch/model/run_simulations.py:位置/失联/四模式/右侧优先/重触发完成握手。",
        "tb_touch_voice5120帧逐样本等效；tb_touch_filter4096帧；tb_touch_system真实UART/ADC/PT8211通路。"
      ],
      "timing_diagrams": [
        {
          "id": "touch",
          "title": "触摸事件与调制提交",
          "scenario": "touch",
          "description": "触摸采集在系统域提交，调制每毫秒平滑；音频帧独立执行，NoteOff确认之后才重新起音。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p........."
              },
              {
                "name": "position_update",
                "wave": "010...10.."
              },
              {
                "name": "control_tick",
                "wave": "0..10...10"
              },
              {
                "name": "audio_frame",
                "wave": "0101010101"
              },
              {
                "name": "row_noteoff",
                "wave": "0..10....."
              },
              {
                "name": "keys_idle_ack",
                "wave": "0.....10.."
              },
              {
                "name": "row_noteon",
                "wave": "0......10."
              }
            ]
          }
        }
      ]
    }
  ]
}
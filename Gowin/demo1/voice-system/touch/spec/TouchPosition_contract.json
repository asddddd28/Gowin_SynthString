{
  "modules": [
    {
      "name": "TouchPosition",
      "rtl_path": "rtl/TouchPosition.v",
      "description": "双轴单触点重心；原始行电极5个映射X，列电极7个映射Y，归一化0..1023。",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "i_rstn"
          },
          {
            "name": "i_raw",
            "direction": "input",
            "width": 336,
            "role": "data",
            "description": "i_raw"
          },
          {
            "name": "i_sequence",
            "direction": "input",
            "width": 16,
            "role": "data",
            "description": "i_sequence"
          },
          {
            "name": "i_error",
            "direction": "input",
            "width": 8,
            "role": "data",
            "description": "i_error"
          },
          {
            "name": "o_update",
            "direction": "output",
            "width": 1,
            "role": "data",
            "description": "o_update"
          },
          {
            "name": "o_touch",
            "direction": "output",
            "width": 1,
            "role": "data",
            "description": "o_touch"
          },
          {
            "name": "o_x",
            "direction": "output",
            "width": 10,
            "role": "data",
            "description": "o_x"
          },
          {
            "name": "o_y",
            "direction": "output",
            "width": 10,
            "role": "data",
            "description": "o_y"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "双轴单触点重心；原始行电极5个映射X，列电极7个映射Y，归一化0..1023。",
        "检测扫描序号改变后逐电极提取、求权重、乘坐标并累加；再并行做两个10拍移位减法除法。没有组合除法器。",
        "扫描器原子发布336位数据，约毫秒更新；计算期间若序号变化立即放弃，完成时重新校验。",
        "两个轴均须有连续触摸簇，断裂多簇、缺轴、错误不产生有效触摸。输出位置仅在COMMIT提交，update为一拍。"
      ],
      "constraints": [
        "50MHz系统域；实时控制不依赖串口；ROM由touch_model.py生成。"
      ],
      "corner_cases": [
        "复位、数据过期、触点跳变、重复包、在途按键命令、方向与模式切换、空行。"
      ],
      "verification_cases": [
        "touch/model/run_simulations.py:位置/失联/四模式/右侧优先/重触发完成握手。",
        "tb_touch_voice5120帧逐样本等效；tb_touch_filter4096帧；tb_touch_system真实UART/ADC/PT8211通路。"
      ],
      "timing_diagrams": [
        {
          "id": "touch",
          "title": "触摸事件与调制提交",
          "scenario": "touch",
          "description": "触摸采集在系统域提交，调制每毫秒平滑；音频帧独立执行，NoteOff确认之后才重新起音。",
          "wavejson": {
            "signal": [
              {
                "name": "clk",
                "wave": "p........."
              },
              {
                "name": "position_update",
                "wave": "010...10.."
              },
              {
                "name": "control_tick",
                "wave": "0..10...10"
              },
              {
                "name": "audio_frame",
                "wave": "0101010101"
              },
              {
                "name": "row_noteoff",
                "wave": "0..10....."
              },
              {
                "name": "keys_idle_ack",
                "wave": "0.....10.."
              },
              {
                "name": "row_noteon",
                "wave": "0......10."
              }
            ]
          }
        }
      ]
    }
  ]
}
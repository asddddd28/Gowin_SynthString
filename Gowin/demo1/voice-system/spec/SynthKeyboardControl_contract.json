{
  "modules": [
    {
      "name": "SynthKeyboardControl",
      "rtl_path": "rtl/SynthKeyboardControl.v",
      "description": "Atomic keyboard calibration, ADC threshold debounce and physical press velocity",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "clock",
            "description": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "reset",
            "description": "i_rstn"
          },
          {
            "name": "i_key",
            "direction": "input",
            "width": 5,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_key"
          },
          {
            "name": "i_raw",
            "direction": "input",
            "width": 12,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_raw"
          },
          {
            "name": "i_valid",
            "direction": "input",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_valid"
          },
          {
            "name": "o_pressed",
            "direction": "output",
            "width": 32,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_pressed"
          },
          {
            "name": "o_calibrating",
            "direction": "output",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_calibrating"
          },
          {
            "name": "o_velocity_enabled",
            "direction": "output",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_velocity_enabled"
          },
          {
            "name": "i_velocity_key",
            "direction": "input",
            "width": 5,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_velocity_key"
          },
          {
            "name": "o_velocity",
            "direction": "output",
            "width": 7,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_velocity"
          },
          {
            "name": "i_request",
            "direction": "input",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_request"
          },
          {
            "name": "i_opcode",
            "direction": "input",
            "width": 8,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_opcode"
          },
          {
            "name": "i_argument",
            "direction": "input",
            "width": 8,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_argument"
          },
          {
            "name": "i_words",
            "direction": "input",
            "width": 64,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "i_words"
          },
          {
            "name": "o_response_valid",
            "direction": "output",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_response_valid"
          },
          {
            "name": "o_response",
            "direction": "output",
            "width": 136,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_response"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "Two threshold banks and two velocity curve banks; commit requires32 threshold writes and16 curve chunks. Calibration/configuration mutes physical keys and requires release to rearm.",
        "Timestamp in1us units; interpolate both ADC thresholds between adjacent samples with shared iterative divider; freeze elapsed at first press crossing and confirm on second sample.128us bins below4.096ms,16bins/octave thereafter.",
        "Local kind3 opcodes20..28, KBD2 capability.28 returns atomic32bit travel_us,scan_interval_us,key/velocity/estimated and1us timer unit. Staging watchdog5seconds; UART owns replay.",
        "ADC processing bounded below96 core clocks; synchronous memories, unchanged sensor scan cadence. Fixed mode preserves previous map velocity/unity gain."
      ],
      "constraints": [
        "50MHz; C_US_CYCLES=50,C_MS_CYCLES=50000,C_TIMEOUT_MS=5000; ADC conversions spaced by at least96 clocks. History interpolation valid only for forward bracketed motion and interval1..65535us.",
        "Calibration UI in App only. Runtime held states cleared on calibration/configuration/timeout."
      ],
      "corner_cases": [
        "Both ADC directions; incomplete config; threshold chatter; held key during commit; same-sample fast crossing; long holds; watchdog."
      ],
      "verification_cases": [
        "tb_keyboard_control and keyboard_model.py; full tb_studio_system; Rust calibration validation and complete50MHz implementation."
      ],
      "timing_diagrams": [
        {
          "id": "press",
          "title": "Threshold traversal and confirmation",
          "scenario": "press",
          "description": "Velocity ends at first press crossing, NoteOn waits for the second.",
          "wavejson": {
            "signal": [
              {
                "name": "sample",
                "wave": "p......."
              },
              {
                "name": "raw",
                "wave": "=.==..=.",
                "data": [
                  "rest",
                  "release-cross",
                  "press-cross",
                  "press-held"
                ]
              },
              {
                "name": "timer",
                "wave": "0.1.0..."
              },
              {
                "name": "velocity_latched",
                "wave": "0...10.."
              },
              {
                "name": "pressed",
                "wave": "0.....1."
              }
            ]
          }
        }
      ]
    }
  ]
}
{
  "modules": [
    {
      "name": "SynthPcmOutput",
      "rtl_path": "rtl/SynthPcmOutput.v",
      "description": "Q26 stereo to saturated signed16 with symmetric nearest rounding; consume PCM only at fixed1024-clock frame boundaries.",
      "interfaces": {
        "ports": [
          {
            "name": "i_clk",
            "direction": "input",
            "width": 1,
            "role": "clock",
            "description": "i_clk"
          },
          {
            "name": "i_rstn",
            "direction": "input",
            "width": 1,
            "role": "reset",
            "description": "i_rstn"
          },
          {
            "name": "i_valid",
            "direction": "input",
            "width": 1,
            "role": "control",
            "description": "i_valid"
          },
          {
            "name": "i_data",
            "direction": "input",
            "width": 64,
            "role": "data",
            "description": "i_data"
          },
          {
            "name": "o_ready",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "o_ready"
          },
          {
            "name": "o_bclk",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "o_bclk"
          },
          {
            "name": "o_ws",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "o_ws"
          },
          {
            "name": "o_data",
            "direction": "output",
            "width": 1,
            "role": "control",
            "description": "o_data"
          },
          {
            "name": "o_frames",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "o_frames"
          },
          {
            "name": "o_underruns",
            "direction": "output",
            "width": 32,
            "role": "data",
            "description": "o_underruns"
          },
          {
            "name": "o_sample_valid",
            "direction": "output",
            "width": 1,
            "clock_domain": "i_clk",
            "role": "control",
            "description": "o_sample_valid"
          },
          {
            "name": "o_sample",
            "direction": "output",
            "width": 16,
            "clock_domain": "i_clk",
            "role": "data",
            "description": "o_sample"
          },
          {
            "name": "i_click",
            "direction": "input",
            "width": 16,
            "role": "data",
            "description": "i_click"
          }
        ]
      },
      "clock": {
        "name": "i_clk",
        "edge": "posedge",
        "frequency_hz": 50000000
      },
      "reset": {
        "name": "i_rstn",
        "active": "low",
        "style": "asynchronous",
        "values": "all pipeline valid and output data/tag registers clear; external synchronous release"
      },
      "behavior": [
        "PT8211 runs at 50MHz/1024 with signed16 left/right samples, rounded and saturated from Q26.",
        "o_sample_valid is true only on the actual output frame acceptance; o_sample is that same signed16 left-channel value. No sampling, interpolation or visualization affects audio readiness.",
        "C_METRONOME_ENABLE默认0。启用时在原Q26→16位舍入后以17位相加再饱和；固定1024拍PT8211帧率不变，旁路监测包含节拍。",
        "Quantization is floor(x/2048) plus bit10 AND (nonnegative OR any low10 bits), then signed16 saturation. This is bit-exact nearest rounding with ties away from zero, without 33-bit absolute-value/sign-restore carry chains."
      ],
      "constraints": [
        "Verilog-2001, single50MHz clock; asynchronous reset assertion, externally synchronized release.",
        "See SYSTEM.md and model/system_model.py for ABI, numerical behavior, memory images and validation scope."
      ],
      "corner_cases": [
        "signed minima/maxima and zero",
        "changing tags and parameters every accepted beat",
        "long backpressure and bubbles",
        "reset while pipeline holds transactions"
      ],
      "verification_cases": [
        "Full existing board regression: 134 UART replies, all 32 keys, eight-voice load and serial DAC.",
        "tb_studio_system: local command CRC/replay, distinct key patches, held remapping/release, 512 signed16 capture samples compared to DAC quantization, tagged latency.",
        "tb_pcm_rounding: 128672 independent Python oracle vectors covering all 2048 remainders at 14 signed boundary classes and 100000 deterministic random values; compares original/new DAC pins, frame/underrun counters and monitor samples, with metronome disabled/enabled and valid bubbles."
      ],
      "timing_diagrams": [
        {
          "id": "pcm-frame",
          "title": "固定帧边界接收 PCM",
          "scenario": "pcm-frame",
          "description": "示意连续的 50 MHz 周期；每 1024 拍产生一次 ready。ready 与 valid 同时为高时锁存当前已舍入、饱和及混入节拍的左右声道数据。组合舍入替换不增加时钟周期。",
          "wavejson": {
            "signal": [
              {
                "name": "i_clk",
                "wave": "p......."
              },
              {
                "name": "cnt_frame",
                "wave": "========",
                "data": [
                  "1022",
                  "1023",
                  "0",
                  "1",
                  "2",
                  "3",
                  "4",
                  "5"
                ]
              },
              {
                "name": "i_valid",
                "wave": "1......."
              },
              {
                "name": "o_ready",
                "wave": "0.10...."
              },
              {
                "name": "o_sample_valid",
                "wave": "0.10...."
              },
              {
                "name": "i_data",
                "wave": "=.......",
                "data": [
                  "Q26 stereo"
                ]
              },
              {
                "name": "o_sample",
                "wave": "=.......",
                "data": [
                  "rounded + click, saturated"
                ]
              },
              {
                "name": "reg_left/right",
                "wave": "=..=....",
                "data": [
                  "previous",
                  "accepted sample"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}

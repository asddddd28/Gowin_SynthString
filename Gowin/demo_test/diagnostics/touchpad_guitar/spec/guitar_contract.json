            "direction": "inout",
            "width": 1,
            "role": "data",
            "description": "io_sda; see behavior contract"
          },
          {
            "name": "o_raw",
            "direction": "output",
            "width": 336,
            "role": "data",
            "description": "o_raw; see behavior contract"
          },
          {
